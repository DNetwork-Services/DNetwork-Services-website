rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access to product images
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin-only access
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
